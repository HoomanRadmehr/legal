# Select one deployment settings module. Compose may set this directly.
DJANGO_SETTINGS_MODULE=config.settings.development

# Django
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://0.0.0.0:5173,http://localhost:4173,http://127.0.0.1:4173,http://0.0.0.0:4173
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://0.0.0.0:5173,http://localhost:4173,http://127.0.0.1:4173,http://0.0.0.0:4173
DJANGO_LANGUAGE_CODE=en
DJANGO_TIME_ZONE=UTC

# Production notes:
# - DJANGO_SECRET_KEY must be a long deployment secret.
# - DJANGO_ALLOWED_HOSTS must never include *.
# - DJANGO_CORS_ALLOWED_ORIGINS and DJANGO_CSRF_TRUSTED_ORIGINS must use https:// origins.
# - DEBUG, HTTPS redirect, HSTS, secure cookies, content sniffing protection, and frame denial
#   are controlled by settings modules, not by environment booleans.

# PostgreSQL
POSTGRES_DB=legal_management
POSTGRES_USER=legal_management
POSTGRES_PASSWORD=replace-me
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://legal_management:replace-me@postgres:5432/legal_management

# Redis
REDIS_URL=redis://redis:6379/0
CHANNEL_LAYER_REDIS_URL=redis://redis:6379/1

# RabbitMQ and Celery
RABBITMQ_DEFAULT_USER=legal_management
RABBITMQ_DEFAULT_PASS=replace-me
CELERY_BROKER_URL=amqp://legal_management:replace-me@rabbitmq:5672//
CELERY_RESULT_BACKEND=redis://redis:6379/2

# MinIO
MINIO_INTERNAL_ENDPOINT=minio:9000
MINIO_ENDPOINT=minio:9000
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_TEST_PUBLIC_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=replace-me
MINIO_SECRET_KEY=replace-me
MINIO_BUCKET_DOCUMENTS=legal-documents
MINIO_REGION=us-east-1
MINIO_USE_SSL=false
MINIO_PRESIGNED_UPLOAD_TTL_SECONDS=900
MINIO_PRESIGNED_DOWNLOAD_TTL_SECONDS=300
MAX_UPLOAD_SIZE_BYTES=26214400

# JWT and cookies
JWT_ACCESS_MINUTES=10
JWT_REFRESH_DAYS=7
JWT_REFRESH_COOKIE_NAME=legal_refresh
JWT_COOKIE_DOMAIN=

# Email; development may use console backend
EMAIL_HOST=mailpit
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=false
DEFAULT_FROM_EMAIL=legal-management@example.test

# Optional provider credentials. Leave blank until an implementation task enables a provider.
SMS_PROVIDER=
SMS_API_KEY=
PUSH_PROVIDER=
PUSH_API_KEY=

# Frontend build-time values
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_WS_BASE_URL=ws://localhost:8000/ws/v1
VITE_DEFAULT_LOCALE=en
